DB_USER=postgres
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoexamgrading

# Use asyncpg for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# JWT configuration
JWT_SECRET_KEY=generate_a_secure_random_string_here_for_access_tokens
JWT_REFRESH_SECRET_KEY=generate_a_secure_random_string_here_for_refresh_tokens

# Initial Superadmin Configuration
SUPERADMIN_PASSWORD=change_this_before_deploying

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Environment (development or production)
ENV=development
